{
  "name": "tandem",
  "displayName": "Tandem",
  "description": "Annotate code as you read, copy the annotations as Markdown, and follow code tours written by an agent.",
  "publisher": "saiashirwad",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.138.0"
  },
  "main": "./src/extension.ts",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tandem-tour",
          "title": "Tour",
          "icon": "$(map)"
        }
      ]
    },
    "views": {
      "tandem-tour": [
        {
          "type": "webview",
          "id": "tandem.tour",
          "name": "Tour"
        }
      ]
    },
    "commands": [
      {
        "command": "tandem.annotateSelection",
        "title": "Annotate Selection",
        "category": "Tandem"
      },
      {
        "command": "tandem.annotateFile",
        "title": "Annotate File",
        "category": "Tandem",
        "icon": "$(comment)"
      },
      {
        "command": "tandem.copySession",
        "title": "Copy Tandem Session",
        "icon": "$(copy)"
      },
      {
        "command": "tandem.clearSession",
        "title": "Clear Tandem Session",
        "icon": "$(clear-all)"
      },
      {
        "command": "tandem.annotate",
        "title": "Annotate"
      },
      {
        "command": "tandem.editAnnotation",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "tandem.deleteAnnotation",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "tandem.saveAnnotation",
        "title": "Save"
      },
      {
        "command": "tandem.cancelEdit",
        "title": "Cancel"
      },
      {
        "command": "tandem.tourNext",
        "title": "Next Step",
        "category": "Tandem",
        "icon": "$(arrow-right)",
        "enablement": "tandem.tourActive"
      },
      {
        "command": "tandem.tourPrevious",
        "title": "Previous Step",
        "category": "Tandem",
        "icon": "$(arrow-left)",
        "enablement": "tandem.tourActive"
      },
      {
        "command": "tandem.tourCurrent",
        "title": "Go to Current Step",
        "category": "Tandem",
        "icon": "$(location)",
        "enablement": "tandem.tourActive"
      },
      {
        "command": "tandem.tourUnfocus",
        "title": "Unfocus Step",
        "category": "Tandem",
        "icon": "$(close)",
        "enablement": "tandem.tourFocused"
      },
      {
        "command": "tandem.tourClear",
        "title": "Clear Tour",
        "category": "Tandem",
        "enablement": "tandem.tourLoaded"
      }
    ],
    "keybindings": [
      {
        "command": "tandem.annotateSelection",
        "key": "alt+a",
        "when": "editorTextFocus"
      },
      {
        "command": "tandem.tourNext",
        "key": "alt+]",
        "when": "tandem.tourActive"
      },
      {
        "command": "tandem.tourPrevious",
        "key": "alt+[",
        "when": "tandem.tourActive"
      }
    ],
    "menus": {
      "comments/commentThread/context": [
        {
          "command": "tandem.annotate",
          "group": "inline",
          "when": "commentController == tandem"
        }
      ],
      "comments/comment/title": [
        {
          "command": "tandem.editAnnotation",
          "group": "group@1",
          "when": "commentController == tandem"
        },
        {
          "command": "tandem.deleteAnnotation",
          "group": "group@2",
          "when": "commentController == tandem"
        }
      ],
      "comments/comment/context": [
        {
          "command": "tandem.cancelEdit",
          "group": "inline@1",
          "when": "commentController == tandem"
        },
        {
          "command": "tandem.saveAnnotation",
          "group": "inline@2",
          "when": "commentController == tandem"
        }
      ],
      "commandPalette": [
        {
          "command": "tandem.annotate",
          "when": "false"
        },
        {
          "command": "tandem.editAnnotation",
          "when": "false"
        },
        {
          "command": "tandem.deleteAnnotation",
          "when": "false"
        },
        {
          "command": "tandem.saveAnnotation",
          "when": "false"
        },
        {
          "command": "tandem.cancelEdit",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "tandem.copySession",
          "group": "navigation",
          "when": "view == workbench.panel.comments"
        },
        {
          "command": "tandem.clearSession",
          "group": "navigation",
          "when": "view == workbench.panel.comments"
        },
        {
          "command": "tandem.tourPrevious",
          "group": "navigation@1",
          "when": "view == tandem.tour && tandem.tourActive"
        },
        {
          "command": "tandem.tourNext",
          "group": "navigation@2",
          "when": "view == tandem.tour && tandem.tourActive"
        },
        {
          "command": "tandem.tourCurrent",
          "group": "navigation@3",
          "when": "view == tandem.tour && tandem.tourActive"
        },
        {
          "command": "tandem.tourUnfocus",
          "group": "navigation@4",
          "when": "view == tandem.tour && tandem.tourFocused"
        },
        {
          "command": "tandem.tourClear",
          "group": "tour",
          "when": "view == tandem.tour && tandem.tourLoaded"
        }
      ],
      "editor/title": [
        {
          "command": "tandem.annotateFile",
          "group": "navigation",
          "when": "resourceScheme == file"
        }
      ],
      "explorer/context": [
        {
          "command": "tandem.annotateFile",
          "group": "tandem",
          "when": "!explorerResourceIsFolder"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "**/.tandem/tour.json",
        "url": "./schemas/tour.schema.json"
      }
    ],
    "colors": [
      {
        "id": "tandem.tourHighlight",
        "description": "Background of the current tour step's lines.",
        "defaults": {
          "dark": "#3794ff1f",
          "light": "#0066bf14",
          "highContrast": "#3794ff33",
          "highContrastLight": "#0066bf1f"
        }
      }
    ]
  },
  "scripts": {
    "check": "tsc --noEmit && tsc --noEmit -p media && oxlint src media",
    "lint": "oxlint src media"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.85.0",
    "@types/node": "^24",
    "@types/vscode": "^1.138.0",
    "oxlint": "1.85.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "mermaid": "^11.17.2",
    "valibot": "^1.5.0"
  }
}
